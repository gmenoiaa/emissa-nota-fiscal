# Local development: use the certificate path.
NFSE_CERT_PATH=./certificates/certificate.pfx
# Vercel: use the base64 content instead of a filesystem path.
NFSE_CERT_BASE64=
NFSE_CERT_PASSWORD=

# Required on Vercel. Use long, unique random values.
APP_PASSWORD=
AUTH_SECRET=

# Restricted production is the default until you explicitly enable production.
NFSE_ENV=restricted
NFSE_RESTRICTED_URL=https://sefin.producaorestrita.nfse.gov.br/API/SefinNacional
NFSE_PRODUCTION_URL=https://sefin.nfse.gov.br/SefinNacional
NFSE_ALLOW_PRODUCTION=false

# The highest example supplied was DPS 7. Confirm this before the first real issue.
NFSE_NEXT_DPS_NUMBER=8

# Required on Vercel for atomic DPS numbering. An Upstash integration can create these.
KV_REST_API_URL=
KV_REST_API_TOKEN=
NFSE_DPS_SEQUENCE_KEY=nfse:next-dps-number
